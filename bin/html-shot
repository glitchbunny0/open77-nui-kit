#!/usr/bin/env python3
"""html-shot: screenshot a WebUI page (lrbind bindings) once per case, with the case's models injected, so that
`rml-preview --compare <out>` puts the WebUI page next to its NativeUI twin.

  html-shot PAGE.html CASES.json|- --out DIR [--model NAME] [--serve-root DIR] [--bg COLOR] [--wait MS] [--timeout S]
  html-shot --find          print the Chromium it would use (exit 2 when there is none)

For every case the page is served over a local HTTP server (127.0.0.1, an ephemeral port, only while it runs) with
one script added before </body>: LrBind.init({ models: { <model>: case.model, ...case.models },
events: { <model>: case.events } }). Chromium's headless shell takes the shot at the case's size (default 1920x1080).

A shot only counts when the bindings ran. The injected script reports back to the server (errors thrown by the page or
by LrBind.init, lrbind's own warnings, any {{ }} left in the text of the page) and a case is a
FAIL, exit status 1, when LrBind is missing, a script threw, a {{ }} is still in the page, or no report came. The PNG
of a failed case is kept for a look. lrbind.js may be loaded by a plain, deferred or module script (init runs when the
page has loaded); a script that loads it later than that (a bundler's async chunk) is reported as missing.
  --model       the model name (default: the page's data-model attribute)
  --serve-root  the folder served (default: the page's parent folder, so ../fonts and ../assets resolve)
  --bg          a backdrop colour behind the page (default #141A20, rml-preview's own backdrop; 'none' for white)
  --wait        virtual time budget for fonts and images, ms (default 2500)
  --timeout     seconds before a Chromium run is killed (with everything it started) and the case fails (default 120)
The PNG is <out>/<case name>.png with every character outside [A-Za-z0-9_.-] written as _ (two cases that end up with
the same file name are refused).
Chromium: $NUIKIT_CHROME, else Playwright's headless shell ($PLAYWRIGHT_BROWSERS_PATH, then
$XDG_CACHE_HOME/ms-playwright, ~/.cache/ms-playwright, ~/Library/Caches/ms-playwright, %LOCALAPPDATA%\\ms-playwright,
the first with a shell), else chromium/google-chrome on PATH. Exit status 2 when none is found
(the tool is optional locally; the kit's CI requires it).
"""
import argparse, glob, http.server, json, os, re, shutil, signal, socketserver, subprocess, sys, tempfile, threading


def die(msg, code=2):
    print('html-shot: ' + msg, file=sys.stderr)
    sys.exit(code)


def find_chrome():
    env = os.environ.get('NUIKIT_CHROME')
    if env:
        return env if os.path.exists(env) else None
    roots = []
    if os.environ.get('PLAYWRIGHT_BROWSERS_PATH') not in (None, '', '0'):
        roots.append(os.path.expanduser(os.environ['PLAYWRIGHT_BROWSERS_PATH']))
    if os.environ.get('XDG_CACHE_HOME'):
        roots.append(os.path.join(os.environ['XDG_CACHE_HOME'], 'ms-playwright'))
    roots.append(os.path.expanduser('~/.cache/ms-playwright'))
    roots.append(os.path.expanduser('~/Library/Caches/ms-playwright'))
    if os.environ.get('LOCALAPPDATA'):   # Windows
        roots.append(os.path.join(os.environ['LOCALAPPDATA'], 'ms-playwright'))
    patterns = ('chromium_headless_shell-*/chrome-headless-shell-linux64/chrome-headless-shell',
                'chromium_headless_shell-*/chrome-linux/headless_shell',      # Linux on arm64
                'chromium_headless_shell-*/chrome-headless-shell-mac*/chrome-headless-shell',
                'chromium_headless_shell-*/chrome-headless-shell-win64/chrome-headless-shell.exe')

    def revision(path):
        m = re.search(r'-(\d+)[/\\]', path)
        return int(m.group(1)) if m else 0
    for root in roots:
        shells = sorted((p for pat in patterns for p in glob.glob(os.path.join(root, pat))), key=revision)
        if shells:
            return shells[-1]
    for name in ('chromium', 'chromium-browser', 'google-chrome', 'google-chrome-stable'):
        p = shutil.which(name)
        if p:
            return p
    return None


def model_name(html):
    m = re.search(r'data-model\s*=\s*"([^"]+)"', html)
    return m.group(1) if m else None


# two scripts are added to the page: INJECT_HEAD first thing in <head> (so that an error of the page's own scripts is
# seen), INJECT before </body>: it runs LrBind.init with the case's models and reports back to the server
INJECT_HEAD = r"""<script>window.__htmlShot = { errors: [], warnings: [] };
window.addEventListener('error', function (e) {
  var h = window.__htmlShot;
  if (e.target && e.target !== window) h.warnings.push('failed to load ' + (e.target.src || e.target.href || e.target.nodeName));
  else h.errors.push('script error: ' + (e.message || e.type) + (e.filename ? ' (' + e.filename.split('/').pop() + ':' + e.lineno + ')' : ''));
}, true);
window.addEventListener('unhandledrejection', function (e) { window.__htmlShot.errors.push('unhandled rejection: ' + e.reason); });
</script>"""
INJECT = r"""<script>(function () {
  var h = window.__htmlShot, errors = h.errors, warnings = h.warnings, reported = false;
  function raw() {
    var out = [], w = document.createTreeWalker(document.body || document.documentElement, NodeFilter.SHOW_TEXT);
    while (w.nextNode()) {
      var n = w.currentNode, p = n.parentNode && n.parentNode.nodeName;
      if (p === 'SCRIPT' || p === 'STYLE' || p === 'TEMPLATE' || p === 'NOSCRIPT') continue;
      if (n.nodeValue.indexOf('{{') >= 0) out.push(n.nodeValue.trim().slice(0, 60));
    }
    return out.slice(0, 5);
  }
  function report() {
    if (reported) return;
    reported = true;
    try {
      var x = new XMLHttpRequest();
      x.open('POST', '/__html-shot__/report/@KEY@', false);
      x.send(JSON.stringify({ errors: errors, warnings: warnings, raw: raw() }));
    } catch (e) {}
  }
  function go() {
    try {
      if (typeof LrBind === 'undefined') throw new Error('LrBind is not defined: lrbind.js did not load before the page finished loading');
      if (LrBind.onError) LrBind.onError(function (m) { warnings.push('lrbind: ' + m); });
      LrBind.init(@SPEC@);
      if (LrBind.flush) LrBind.flush();
    } catch (e) { errors.push(String(e && e.message || e)); }
    setTimeout(report, 50);
  }
  if (typeof LrBind === 'undefined' && document.readyState === 'loading') document.addEventListener('DOMContentLoaded', go);
  else go();
})();</script>"""


def safe_name(name):
    """the case name as a file name and as the report key: no separators, no leading dot"""
    s = re.sub(r'[^\w.-]', '_', name)
    return '_' + s if s.startswith('.') or not s else s


def wrapper(html, page_url_dir, case, model, bg, key):
    models = dict(case.get('models') or {})
    if 'model' in case:
        models[model] = case['model']
    events = {model: case.get('events') or []}
    for k in (case.get('models') or {}):
        events.setdefault(k, [])
    spec = json.dumps({'models': models, 'events': events}).replace('</', '<\\/')
    inject = INJECT.replace('@KEY@', key).replace('@SPEC@', spec)
    style = '' if bg == 'none' else '<style>html { background: %s; }</style>' % bg
    base = '<base href="%s">' % page_url_dir
    if re.search(r'<head[^>]*>', html, re.I):
        html = re.sub(r'(<head[^>]*>)', lambda m: m.group(1) + INJECT_HEAD + base + style, html, count=1, flags=re.I)
    else:
        html = INJECT_HEAD + base + style + html
    if re.search(r'</body>', html, re.I):
        k = [m.start() for m in re.finditer(r'</body>', html, re.I)][-1]
        return html[:k] + inject + html[k:]
    return html + inject


def verdict(rep):
    """None when the bindings ran, else why the shot is no good"""
    if rep is None:
        return 'the page sent no report (the injected script never ran: a page that did not load, or one that blocks scripts)'
    if rep.get('errors'):
        return '; '.join(rep['errors'][:3])
    if rep.get('raw'):
        return 'unbound {{ }} left in the page: ' + ' | '.join(rep['raw'][:3])
    return None


def kill_tree(proc):
    """kill a process with everything it started"""
    if os.name == 'nt':   # no process groups: taskkill walks the tree from the pid down
        subprocess.run(['taskkill', '/F', '/T', '/PID', str(proc.pid)], capture_output=True)
    else:
        os.killpg(proc.pid, signal.SIGKILL)


def run_chrome(cmd, timeout):
    """(returncode, stderr); a run that outlives the timeout is killed with everything it started"""
    try:   # its own session on POSIX, so that killpg reaches its children (Windows ignores start_new_session)
        proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, start_new_session=True)
    except OSError as e:
        die(f'cannot run {cmd[0]}: {e}')
    try:
        _, err = proc.communicate(timeout=timeout)
        return proc.returncode, err.decode('utf-8', 'replace')
    except subprocess.TimeoutExpired:
        kill_tree(proc)
        proc.communicate()
        return None, f'Chromium did not finish in {timeout} s and was killed'
    except BaseException:
        kill_tree(proc)
        raise


def main():
    for s in (sys.stdout, sys.stderr):   # UTF-8 and \n on every OS (a Windows pipe gets the ANSI code page and \r\n)
        if hasattr(s, 'reconfigure'):
            s.reconfigure(encoding='utf-8', errors='backslashreplace', newline='\n')
    if sys.argv[1:] == ['--find']:
        c = find_chrome()
        print(c or 'none')
        sys.exit(0 if c else 2)
    ap = argparse.ArgumentParser(prog='html-shot', description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('page')
    ap.add_argument('cases')
    ap.add_argument('--out', required=True)
    ap.add_argument('--model')
    ap.add_argument('--serve-root')
    ap.add_argument('--bg', default='#141A20')
    ap.add_argument('--wait', type=int, default=2500)
    ap.add_argument('--timeout', type=int, default=120)
    a = ap.parse_args()
    if not os.path.exists(a.page):
        die(f'page not found: {a.page}')
    chrome = find_chrome()
    if not chrome:
        die('no Chromium found: set NUIKIT_CHROME to a chrome/chrome-headless-shell binary '
            '(npx playwright install chromium-headless-shell gives one)')
    txt = sys.stdin.read() if a.cases == '-' else open(a.cases, encoding='utf-8').read()
    cases = json.loads(txt)
    if not isinstance(cases, list) or not all(isinstance(c, dict) and isinstance(c.get('name'), str) for c in cases):
        die('cases must be a JSON array of objects with a "name" (see docs/cases.md)')
    names = {}
    for c in cases:
        other = names.setdefault(safe_name(c['name']), c['name'])
        if other != c['name']:
            die(f'the cases "{other}" and "{c["name"]}" would both be written to {safe_name(c["name"])}.png')
    page = os.path.abspath(a.page)
    html = open(page, encoding='utf-8').read()
    model = a.model or model_name(html) or 'model'
    root = os.path.abspath(a.serve_root or os.path.dirname(os.path.dirname(page)))
    if not page.startswith(root + os.sep):
        die(f'the page is not under --serve-root {root}')
    rel_dir = os.path.relpath(os.path.dirname(page), root).replace(os.sep, '/')
    pages, reports = {}, {}

    class Handler(http.server.SimpleHTTPRequestHandler):
        def __init__(self, *args, **kw):
            super().__init__(*args, directory=root, **kw)

        def do_GET(self):
            path = self.path.split('?')[0]
            if path in pages:
                body = pages[path].encode('utf-8')
                self.send_response(200)
                self.send_header('Content-Type', 'text/html; charset=utf-8')
                self.send_header('Content-Length', str(len(body)))
                self.end_headers()
                self.wfile.write(body)
                return
            super().do_GET()

        def do_POST(self):
            prefix = '/__html-shot__/report/'
            path = self.path.split('?')[0]
            if path.startswith(prefix):
                try:
                    reports[path[len(prefix):]] = json.loads(self.rfile.read(int(self.headers.get('Content-Length') or 0)))
                except ValueError:
                    pass
                self.send_response(204)
            else:
                self.send_response(404)
            self.end_headers()

        def log_message(self, *args):
            pass

    httpd = socketserver.ThreadingTCPServer(('127.0.0.1', 0), Handler)
    httpd.daemon_threads = True
    port = httpd.server_address[1]
    threading.Thread(target=httpd.serve_forever, daemon=True).start()
    os.makedirs(a.out, exist_ok=True)
    ok = 0
    try:
        for c in cases:
            w, h = (c.get('size') or [1920, 1080])[:2]
            safe = safe_name(c['name'])
            key = '/__html-shot__/%s.html' % safe
            pages[key] = wrapper(html, '/%s/' % rel_dir if rel_dir != '.' else '/', c, model, a.bg, safe)
            reports.pop(safe, None)
            png = os.path.abspath(os.path.join(a.out, safe + '.png'))
            if os.path.exists(png):
                os.remove(png)   # a stale shot must not pass for this run's
            cmd = [chrome, '--headless', '--no-sandbox', '--disable-gpu', '--hide-scrollbars',
                   '--window-size=%d,%d' % (w, h),
                   '--virtual-time-budget=%d' % a.wait, '--screenshot=' + png, 'http://127.0.0.1:%d%s' % (port, key)]
            rc, err = run_chrome(cmd, a.timeout)
            if rc != 0:
                print(f'FAIL {c["name"]}: {err.strip()[-400:]}')
                continue
            if not os.path.exists(png) or open(png, 'rb').read(8) != b'\x89PNG\r\n\x1a\n':
                print(f'FAIL {c["name"]}: Chromium wrote no PNG')
                continue
            why = verdict(reports.get(safe))
            for wmsg in (reports.get(safe) or {}).get('warnings', [])[:5]:
                print(f'warn {c["name"]}: {wmsg}')
            if why:
                print(f'FAIL {c["name"]}: {why} (shot kept: {png})')
                continue
            ok += 1
            print('ok  ', png)
    finally:
        httpd.shutdown()
        httpd.server_close()
    if ok != len(cases):
        sys.exit(1)


if __name__ == '__main__':
    main()
