#!/usr/bin/env python3
"""lrbind-sync: give a resource its own copies of lrbind.js / lrbind.lua and keep them current.

  lrbind-sync add <resource>      write <resource>/web/lrbind.js and <resource>/client/lrbind.lua
  lrbind-sync refresh <folder>    overwrite every copy found under <folder> with the kit's files
  lrbind-sync check <folder>      list stale copies under <folder>; exit 1 if any
A copy is a file named lrbind.js in a `web/` folder or lrbind.lua in a `client/` folder.
"""
import filecmp, os, shutil, sys

KIT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
SRC = os.path.join(KIT, 'lrbind')
FILES = {'lrbind.js': 'web', 'lrbind.lua': 'client'}
SKIP = {'node_modules', '.git'}


def copies(root):
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if d not in SKIP]
        if os.path.realpath(dirpath).startswith(os.path.realpath(KIT)):
            continue
        for name in filenames:
            if name in FILES and os.path.basename(dirpath) == FILES[name]:
                yield os.path.join(dirpath, name), name


def main(argv):
    if len(argv) != 3 or argv[1] not in ('add', 'refresh', 'check'):
        print(__doc__.strip())
        return 2
    cmd, target = argv[1], argv[2]
    if not os.path.isdir(target):
        print(f'lrbind-sync: not a folder: {target}')
        return 2
    if cmd == 'add':
        for name, sub in FILES.items():
            os.makedirs(os.path.join(target, sub), exist_ok=True)
            shutil.copyfile(os.path.join(SRC, name), os.path.join(target, sub, name))
            print('wrote', os.path.join(target, sub, name))
        return 0
    stale = []
    n = 0
    for path, name in copies(target):
        n += 1
        if not filecmp.cmp(path, os.path.join(SRC, name), shallow=False):
            stale.append(path)
            if cmd == 'refresh':
                shutil.copyfile(os.path.join(SRC, name), path)
    if cmd == 'refresh':
        print(f'{n} copies, {len(stale)} refreshed')
        return 0
    for p in stale:
        print('stale', p)
    print(f'{n} copies, {len(stale)} stale')
    return 1 if stale else 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))
