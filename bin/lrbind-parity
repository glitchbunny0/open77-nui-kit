#!/usr/bin/env python3
"""lrbind parity: run binding cases through real RmlUi (rmlhost parity) and through lrbind.js in jsdom, compare the
element trees after every step.
  lrbind-parity                         the kit's own suite (lrbind/tests/parity/cases.mjs + golden.json)
  lrbind-parity CASES.mjs GOLDEN.json   your suite; CASES.mjs exports `cases` (see the kit's cases.mjs for the shape,
                                        import { T, sharedBlock } from it to test a block of your own documents)
  lrbind-parity [CASES GOLDEN] --regen  rewrite the golden file from real RmlUi first (after adding or changing a case)
Needs node, a C++ compiler and git; jsdom comes from `npm ci` in lrbind/tests (run once, by this tool when missing)."""
import json, os, shutil, subprocess, sys

KIT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
T = os.path.join(KIT, 'lrbind', 'tests', 'parity')


def tool(name):
    """a command on PATH, by its full path (on Windows npm is npm.cmd, which only a PATHEXT lookup finds)"""
    p = shutil.which(name)
    if not p:
        sys.exit(f'lrbind-parity: {name} not found on PATH')
    return p


def main(argv):
    for s in (sys.stdout, sys.stderr):   # UTF-8 and \n on every OS
        if hasattr(s, 'reconfigure'):
            s.reconfigure(encoding='utf-8', errors='backslashreplace', newline='\n')
    regen = '--regen' in argv
    args = [a for a in argv if a != '--regen']
    if '-h' in args or '--help' in args:
        print(__doc__.strip())
        return 0
    cases, golden = os.path.join(T, 'cases.mjs'), os.path.join(T, 'golden.json')
    if len(args) == 2:
        cases, golden = os.path.realpath(args[0]), os.path.realpath(args[1])
    elif args:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    if not os.path.isdir(os.path.join(KIT, 'lrbind', 'tests', 'node_modules', 'jsdom')):
        r = subprocess.run([tool('npm'), 'ci', '--silent', '--no-audit', '--no-fund'],
                           cwd=os.path.join(KIT, 'lrbind', 'tests'))
        if r.returncode:
            return r.returncode
    node = tool('node')
    if regen:
        b = subprocess.run([sys.executable, os.path.join(KIT, 'scripts', 'build.py')], stdout=subprocess.PIPE)
        if b.returncode:
            return b.returncode
        host = b.stdout.decode('utf-8').strip().splitlines()[-1]
        e = subprocess.run([node, os.path.join(T, 'parity.test.mjs'), '--cases', cases, '--emit-cases'],
                           stdout=subprocess.PIPE)
        if e.returncode:
            return e.returncode
        new = golden + '.new'
        with open(new, 'wb') as f:
            h = subprocess.run([host, 'parity'], input=e.stdout, stdout=f)
        if h.returncode:
            return h.returncode
        with open(new, encoding='utf-8') as f:
            n = len(json.load(f))
        os.replace(new, golden)
        print(f'golden: {n} cases from real RmlUi -> {golden}')
    return subprocess.run([node, os.path.join(T, 'parity.test.mjs'), '--cases', cases, '--golden', golden]).returncode


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
