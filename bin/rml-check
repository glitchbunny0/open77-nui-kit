#!/usr/bin/env python3
"""rml-check: load an RmlUi document in real RmlUi for every case and fail on anything RmlUi complains about.

For every case (a name + the data model your client code builds for that state) the document is parsed, styled,
bound and laid out by real RmlUi (the kit's host, `check` mode; one host process per case, so a stylesheet warning
is reported for every case that sees it). Fails when:
  - RmlUi logs a warning or error that is not on the allowed list (unknown property, bad value, a binding to a model
    member that does not exist, an XML error, a data-for over a non-array, ...);
  - a click listed in the case does not call the model event it should (dispatched on the first VISIBLE element
    the selector matches, with real RmlUi event handling);
  - the document does not load, or there are no cases.
Allowed by default: "No font face defined" (the check runs without fonts) and the properties Open77's NativeUI adds
to RmlUi (see ALLOWED_OPEN77 below). Add your own with --allow REGEX.

  rml-check DOC.rml CASES.json|- [--model NAME] [--allow REGEX ...] [--outline FILE] [--quiet]

  --model    the data model name the cases' "model" binds to (default: the document's first data-model attribute;
             a note says so when the document has several)
  --outline  where to write the element outline of every case (default: a fresh rml-check-*.outline.txt in the
             temp dir; its path is printed)
Environment: NUIKIT_HOST=/path/to/rmlhost uses that host binary instead of building one with scripts/build.sh.
Exit status: 0 clean, 1 warnings or failed clicks, 2 usage, input or build problem.
"""
import argparse, difflib, html, json, os, re, subprocess, sys, tempfile

KIT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
# Properties and values Open77's NativeUI understands and vanilla RmlUi does not: <path>/<shape> paint, the extra
# filters and the fx() decorator. Vanilla RmlUi reports them as syntax errors; they are fine in the game.
ALLOWED_OPEN77 = [
    r"^Syntax error parsing (inline )?property declaration '(fill|stroke|stroke-width|stroke-linejoin|stroke-linecap"
    r"|stroke-dasharray|stroke-dashoffset|trim-start|trim-end|trim-offset): ",
    r"^Syntax error parsing (inline )?property declaration 'filter: [^']*\b(glow|chromatic|scanlines)\(",
    r"^Syntax error parsing (inline )?property declaration 'decorator: [^']*\bfx\(",
    r"^(Filter|Decorator) type '(glow|chromatic|scanlines|fx)' not found",
]
ALLOWED_BASE = [r'^No font face defined']
CASE_KEYS = ['name', 'model', 'models', 'events', 'clicks', 'place', 'size']


def die(msg, code=2):
    print('rml-check: ' + msg, file=sys.stderr)
    sys.exit(code)


def esc(s):
    """A name for a one-line message: control characters shown as escapes."""
    return ''.join(c if c.isprintable() else c.encode('unicode_escape').decode() for c in s)


def read_text(path, what):
    try:
        with open(path, encoding='utf-8') as fh:
            return fh.read()
    except UnicodeDecodeError as e:
        die(f'{what} {path} is not UTF-8: {e}')
    except OSError as e:
        die(f'cannot read {what} {path}: {e.strerror or e}')


# ---- the document

def mask(txt):
    """Blank out comments, CDATA, <style> and <script> bodies (newlines kept, so offsets and lines still match)."""
    def blank(s):
        return re.sub(r'[^\n]', ' ', s)
    txt = re.sub(r'<!--.*?(?:-->|\Z)', lambda m: blank(m.group()), txt, flags=re.S)
    txt = re.sub(r'<!\[CDATA\[.*?(?:\]\]>|\Z)', lambda m: blank(m.group()), txt, flags=re.S)
    return re.sub(r'(<(style|script)\b[^>]*>)(.*?)(?=</\2\s*>|\Z)',
                  lambda m: m.group(1) + blank(m.group(3)), txt, flags=re.S | re.I)


TAG = re.compile(r'<([A-Za-z_][\w:.-]*)((?:\s+[^\s=/<>"\']+(?:\s*=\s*(?:"[^"]*"|\'[^\']*\'|[^\s"\'>]+))?)*)\s*/?>')
ATTR = re.compile(r'([^\s=/<>"\']+)(?:\s*=\s*(?:"([^"]*)"|\'([^\']*)\'|([^\s"\'>]+)))?')


def tags(txt):
    """(tag, {attribute: value}, line) of every start tag in the document's markup."""
    txt = mask(txt)
    for m in TAG.finditer(txt):
        attrs = {}
        for a in ATTR.finditer(m.group(2)):
            v = next((g for g in a.groups()[1:] if g is not None), '')
            attrs.setdefault(a.group(1), html.unescape(v))
        yield m.group(1), attrs, txt.count('\n', 0, m.start()) + 1


def model_names(txt):
    out = []
    for _, attrs, _ in tags(txt):
        if attrs.get('data-model') and attrs['data-model'] not in out:
            out.append(attrs['data-model'])
    return out


# ---- the cases

def validate(cases):
    if not isinstance(cases, list):
        die('cases must be a JSON array of objects with a "name" (see docs/cases.md)')
    if not cases:
        die('no cases: the JSON array is empty, so nothing would be loaded (see docs/cases.md)')
    for n, c in enumerate(cases):
        if not isinstance(c, dict) or not isinstance(c.get('name'), str):
            die('cases must be a JSON array of objects with a "name" (see docs/cases.md)')
        w = f'case {n} ({esc(c["name"])!r})'
        for k in c:
            near = difflib.get_close_matches(k, [x for x in CASE_KEYS if x not in c], 1, 0.8)
            if k not in CASE_KEYS and near:
                die(f'{w}: unknown key {k!r}, did you mean {near[0]!r}?')
        if 'model' in c and not isinstance(c['model'], dict):
            die(f'{w}: "model" must be an object')
        if 'models' in c and not (isinstance(c['models'], dict) and all(isinstance(m, dict) for m in c['models'].values())):
            die(f'{w}: "models" must be an object of objects')
        if 'events' in c and not (isinstance(c['events'], list) and all(isinstance(e, str) and e for e in c['events'])):
            die(f'{w}: "events" must be an array of event names')
        if 'size' in c and not (isinstance(c['size'], list) and len(c['size']) == 2
                                and all(isinstance(x, (int, float)) and not isinstance(x, bool) for x in c['size'])):
            die(f'{w}: "size" must be [width, height]')
        if 'clicks' in c:
            if not isinstance(c['clicks'], list):
                die(f'{w}: "clicks" must be an array of {{"sel", "event", "args"}} objects')
            for k in c['clicks']:
                if not (isinstance(k, dict) and all(isinstance(k.get(f), str) and k[f] and '\n' not in k[f] and '\r' not in k[f]
                                                    for f in ('sel', 'event'))):
                    die(f'{w}: every click needs a one-line string "sel" and "event": {json.dumps(k)[:80]}')
                a = k.get('args', [])
                if not (isinstance(a, list) and all(isinstance(x, (str, int, float, bool)) for x in a)):
                    die(f'{w}: click args must be an array of strings, numbers and bools: {json.dumps(k)[:80]}')


# ---- the host

def host_input(idx, c):
    """The one-case JSON the host reads. The case is renamed to its index (a name with a newline cannot forge host
    output lines), and the text is plain UTF-8 instead of \\u escapes: the host never sees a surrogate pair."""
    txt = json.dumps([dict(c, name=str(idx))], ensure_ascii=False)
    # \r \f \b as \u00XX: the host's string reader knows \n \t \uXXXX only
    txt = re.sub(r'\\(.)', lambda m: {'r': '\\u000d', 'f': '\\u000c', 'b': '\\u0008'}.get(m.group(1), m.group()), txt)
    try:
        return txt.encode('utf-8')
    except UnicodeEncodeError:
        die(f'case {idx} ({esc(c["name"])!r}): a text has an unpaired surrogate (\\ud800-\\udfff), not valid Unicode')


def parse_host(idx, text):
    """The host's output for case idx: outline lines, clicks ok count, failed clicks, warnings, load failure."""
    lines = text.split('\n')
    if lines and lines[-1] == '':
        lines.pop()
    if not lines or lines[0] != f'=== case {idx}':
        die(f'the host printed no "=== case {idx}" header; its output starts: {text[:120]!r}')
    r = {'outline': lines, 'ok': 0, 'fails': [], 'warns': [], 'load': False}
    for line in lines[1:]:
        if r['warns']:
            m = re.match(r'WARN x\d+: ', line)
            if m:
                r['warns'].append(line[m.end():])
            else:                         # the rest of a multi-line message
                r['warns'][-1] += '\n' + line
        elif line == 'LOAD FAILED':
            r['load'] = True
        elif line.startswith('CLICK ok'):
            r['ok'] += 1
        elif line.startswith('CLICK FAIL'):
            r['fails'].append(line[11:])
        elif re.match(r'WARN x\d+: ', line):
            r['warns'].append(re.sub(r'^WARN x\d+: ', '', line))
    return r


def main():
    ap = argparse.ArgumentParser(prog='rml-check', description=__doc__.split('\n')[0])
    ap.add_argument('doc')
    ap.add_argument('cases')
    ap.add_argument('--model')
    ap.add_argument('--allow', action='append', default=[])
    ap.add_argument('--outline')
    ap.add_argument('--quiet', action='store_true')
    a = ap.parse_args()
    if not os.path.isfile(a.doc):
        die(f'document not found: {a.doc}')
    doc_txt = read_text(a.doc, 'document')
    if not doc_txt.strip():
        die(f'document is empty: {a.doc}')
    if a.cases == '-':
        try:
            txt = sys.stdin.buffer.read().decode('utf-8')
        except UnicodeDecodeError as e:
            die(f'cases on stdin are not UTF-8: {e}')
    else:
        txt = read_text(a.cases, 'cases file')

    def no_const(c):
        raise ValueError(f'{c} is not JSON')
    try:
        cases = json.loads(txt, parse_constant=no_const)
    except ValueError as e:
        die(f'cases are not JSON: {e}')
    validate(cases)
    try:
        allowed = [re.compile(p) for p in ALLOWED_BASE + ALLOWED_OPEN77 + a.allow]
    except re.error as e:
        die(f'--allow is not a regular expression: {e}')

    names = model_names(doc_txt)
    model = a.model or (names[0] if names else None)
    if not model and any('model' in c for c in cases):
        die('no --model given and the document has no data-model attribute')
    notes = []
    if not a.model and len(names) > 1:
        notes.append(f'note: the document has several data-model roots ({", ".join(names)}); the cases\' "model" binds '
                     f'to {model} (--model NAME to change it, "models" for the others)')

    host = os.environ.get('NUIKIT_HOST')
    if not host:
        b = subprocess.run(['bash', os.path.join(KIT, 'scripts', 'build.sh')], capture_output=True, text=True)
        if b.returncode != 0 or not b.stdout.strip():
            die('building the host failed:\n' + b.stderr)
        host = b.stdout.strip().splitlines()[-1]

    bad, fails, loadfail, outline = {}, [], [], []
    clicks = 0
    # every case in its own host process: RmlUi caches parsed stylesheets, so one process would report a
    # stylesheet warning for the first case only
    for idx, c in enumerate(cases):
        name = esc(c['name'])
        try:
            r = subprocess.run([host, 'check', a.doc, model or 'model'], input=host_input(idx, c), capture_output=True)
        except OSError as e:
            die(f'cannot run the host {host}: {e.strerror or e}')
        if r.returncode != 0:
            die(f'host failed on case {idx} ({name}) with {r.returncode}:\n' + r.stderr.decode('utf-8', 'replace'))
        res = parse_host(idx, r.stdout.decode('utf-8', 'replace'))
        outline += [f'=== case {name}'] + res['outline'][1:]
        clicks += res['ok']
        fails += [f'{name}: {f}' for f in res['fails']]
        if res['load']:
            loadfail.append(name)
        for msg in res['warns']:
            if not any(p.search(msg) for p in allowed):
                bad.setdefault(msg, []).append(name)

    out = a.outline
    try:
        if out:
            fh = open(out, 'w', encoding='utf-8')
        else:
            fd, out = tempfile.mkstemp(prefix='rml-check-', suffix='.outline.txt')
            fh = os.fdopen(fd, 'w', encoding='utf-8')
        with fh:
            fh.write('\n'.join(outline) + '\n')
    except OSError as e:
        die(f'cannot write the outline: {e.strerror or e}')
    if not a.quiet:
        for n in notes:
            print(n)
        print(f'cases: {len(cases)}  clicks ok: {clicks}  model: {model or "-"}  outline: {out}')

    def where(names):
        return f'[{", ".join(names[:4])}{" ..." if len(names) > 4 else ""}]'
    for msg, names in sorted(bad.items()):
        print(f'WARN  {msg}  {where(names)}')
    for f in fails:
        print('CLICK FAIL ' + f)
    for n in loadfail:
        print(f'LOAD FAILED {n}')
    if bad or fails or loadfail:
        print('rml-check: FAIL')
        sys.exit(1)
    if not a.quiet:
        print('rml-check: ok')


if __name__ == '__main__':
    main()
