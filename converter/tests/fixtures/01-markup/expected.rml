<!-- a comment before the body -->
<body data-model="m">
<div id="root" class="panel">
  <div class="row"><span>Bare text in a flex box</span> <b>bold</b> <span>tail</span></div>
  <div class="row"><span>already wrapped</span></div>
  <p>A paragraph<br/>with a break &amp; an entity &lt;tag&gt; nbsp</p>
  <p>Unclosed paragraph
  </p><div id="note" class="hidden">hidden note</div>
  <div class="if" data-if="a &amp;&amp; b" data-class-on="n > 2" data-event-click="go('x', n)">{{ a ? 'yes' : 'no' }}</div>
  <img src="../../fixtures/01-markup/assets/dot.png" width="8" height="8"/>
  <input type="text" value="3" placeholder="n"/>
  <input type="checkbox" checked=""/>
  <button>Go</button>
  <a>a link</a>
  <div id="chart" style="width: 100dp; height: 50dp;"></div>
  <x-widget class="w">custom</x-widget>
  <ul><li>one</li><li>two</li></ul>
  <h1>Head</h1><small>small</small>
</div>


</body>
</rml>
