/* converted by html2rml from index.html (canvas 1920x1080, 1 px = 1 dp). RmlUi has no default stylesheet: the
   first block is the part of a browser's defaults this page relies on. */
div { display: block; }
body { margin: 8dp; font-size: 16dp; color: #000000; }

#a { transition: opacity 0.25s sine-out, width 0.1s 0.05s linear-in-out, color 1s quintic-out; }
#a { animation: 1.1s quadratic-in-out infinite alternate pulse; }
#b { animation: 0.6s linear-in-out flash; transition: height 2s quadratic-out; }
@keyframes pulse {
    50% { opacity: 0.45; }
}
@keyframes flash {
    from { opacity: 0; }
    to { opacity: 1; transform: scale(1.1); }
}
#c { filter: drop-shadow(#5EF6FFcc 0dp 0dp 3dp) blur(2dp); box-shadow: #00000080 0dp 2dp 4dp, #fff 0dp 0dp 1dp inset; }
#c { transform: translate(-50%, -50%) rotate(45deg) translateZ(1dp); opacity: 0.5; }
#c { backdrop-filter: blur(4dp); }
