/* converted by html2rml from index.html (canvas 1920x1080, 1 px = 1 dp). RmlUi has no default stylesheet: the
   first block is the part of a browser's defaults this page relies on. */
div { display: block; }
body { margin: 8dp; font-size: 16dp; color: #000000; }
b { font-weight: bold; }
i { font-style: italic; }
.html2rml-hidden { display: none; }

body { margin: 0; color: #ffffff; }
body { margin: 4dp; }
div { height: 2dp; }
#spec { background-color: #00ff00; }
#tie { background-color: #00ff00; }
.box { background-color: #0000ff; }
#imps { color: #00ff00; }
.d { background-color: #ff0000; }
.e { background-color: #00ff00; }
.vs { width: 2dp; }
.btn { background-color: #112233; }
.btn:hover { background-color: #ff0000; }
.btn.on { background-color: #00ff00; }
.card { width: 100dp; }
.card[data-state="open"] { width: 300dp; }
.row { background-color: #222222; }
.row:nth-child(odd) { background-color: #111111; }
.row:last-child { background-color: #333333; }
#mark i { display: block; width: 10dp; }
#mark i { width: 5dp; }
.html2rml-root .x { color: #ff0000; }
div .x { color: #0000ff; }
.w b { color: #00ff00; }
#list2 { font-size: 20dp; }
#list2 .row2 { letter-spacing: 2dp; color: #ff0000; }
.nx { width: 10dp; }
u { color: #ff0000; }
[data-state="a"] { width: 3dp; }
.fl { display: flex; }
.fl b:first-child { color: #ff0000; }
.hidden { opacity: 0.5; }
