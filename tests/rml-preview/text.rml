<rml>
<head>
<style>
body { width: 100%; height: 100%; font-family: kitraj; font-size: 30dp; color: #ffffff; }
div { display: block; position: absolute; left: 10dp; white-space: nowrap; }
#t1 { top: 10dp; text-transform: uppercase; }
#t2 { top: 60dp; font-weight: 700; color: #ffcc00; }
#t3 { top: 110dp; font-weight: 400; color: #ffcc00; }
#t4 { top: 160dp; letter-spacing: 6dp; color: #00ffff; }
#t5 { top: 210dp; font-style: italic; color: #ff0000; }
#t6 { top: 260dp; font-family: nosuchfont; color: #ff0000; }
#t7 { top: 310dp; text-transform: capitalize; font-size: 20dp; }
</style>
</head>
<body>
<div id="t1">straße café crème</div>
<div id="t2">Weight 700 is SemiBold here</div>
<div id="t3">Weight 400 is Regular</div>
<div id="t4">SPACED</div>
<div id="t5">italic: no italic face</div>
<div id="t6">unknown family</div>
<div id="t7">capitalized words here</div>
</body>
</rml>
